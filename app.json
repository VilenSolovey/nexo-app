{
  "expo": {
    "name": "Nexo",
    "slug": "Nexo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-nexo.png",
    "scheme": "nexo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexo.app.prod",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nexo.app.prod",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "FIREBASE_API_KEY": "AIzaSyBxSZzBF1KxQR7oOie07rCSu6PhBMDqsVc",
      "FIREBASE_AUTH_DOMAIN": "nexo-app-40233.firebaseapp.com",
      "FIREBASE_PROJECT_ID": "nexo-app-40233",
      "FIREBASE_STORAGE_BUCKET": "nexo-app-40233.firebasestorage.app",
      "FIREBASE_MESSAGING_SENDER_ID": "1054192373939",
      "FIREBASE_APP_ID": "1:1054192373939:web:757521e12f5fdba5eee0c6",
      "FIREBASE_MEASUREMENT_ID": "",
      "router": {},
      "eas": {
        "projectId": "11f39192-2269-4953-afc8-1d5dceb44778"
      }
    }
  }
}
