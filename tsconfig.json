{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2020",
    "moduleResolution": "bundler",
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@nexo/*": [
            "src/*"
          ],
          "@/*": [
            "src/*"
          ],
            "@firebase/auth": ["./node_modules/firebase/node_modules/@firebase/auth/dist/index.rn.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "babel.config.js",
    "metro.config.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, "src"  ],
  "exclude": [
    "node_modules"
  ]
}
