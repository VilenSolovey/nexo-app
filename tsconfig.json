{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2020",
    "moduleResolution": "bundler",
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nexo/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "babel.config.js",
    "metro.config.js"
  ],
  "exclude": ["node_modules"]
}